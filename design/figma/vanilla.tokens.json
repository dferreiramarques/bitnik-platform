      "table-bg": {
        "$type": "string",
        "$value": "radial-gradient(ellipse at 50% 40%, #3f6b52 0%, #2e4a3a 60%, #1f3328 100%)",
        "$description": "Mesa (fundo)",
        "$extensions": {
          "bitnik": {
            "token": "--table-bg",
            "type": "background",
            "collection": "vanilla",
            "mode": "default"
          }
        }
      },
      "table-dots": {
        "$type": "color",
        "$value": "rgba(255,250,241,.14)",
        "$description": "Pontos da mesa",
        "$extensions": {
          "bitnik": {
            "token": "--table-dots",
            "type": "color",
            "collection": "vanilla",
            "mode": "default"
          }
        }
      },
      "game-glass": {
        "$type": "color",
        "$value": "rgba(255,250,241,.3)",
