{
  "name": "bitnik-platform",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "bitnik-platform",
      "workspaces": [
        "packages/*",
        "games/*",
        "apps/*",
        "examples/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "apps/studio": {
      "name": "@bitnik/studio",
      "dependencies": {
        "@bitnik/game-catania": "^3.0.0",
        "@bitnik/server": "^0.1.0"
      }
    },
    "examples/clean-runtime": {
      "name": "example-clean-runtime",
      "dependencies": {
        "@bitnik/game-catania": "^3.0.0",
        "@bitnik/server": "^0.1.0"
      }
    },
    "games/catania": {
      "name": "@bitnik/game-catania",
      "version": "3.0.0",
      "license": "CC-BY-4.0",
      "peerDependencies": {
        "@bitnik/engine": "^0.1.0"
      }
    },
    "node_modules/@bitnik/client": {
      "resolved": "packages/client",
      "link": true
    },
    "node_modules/@bitnik/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@bitnik/game-catania": {
      "resolved": "games/catania",
      "link": true
    },
    "node_modules/@bitnik/server": {
      "resolved": "packages/server",
      "link": true
    },
    "node_modules/@bitnik/studio": {
      "resolved": "apps/studio",
      "link": true
    },
    "node_modules/example-clean-runtime": {
      "resolved": "examples/clean-runtime",
      "link": true
    },
    "node_modules/ws": {
      "version": "8.21.3",
      "resolved": "https://registry.npmjs.org/ws/-/ws-8.21.3.tgz",
      "integrity": "sha512-201TZ/kPWxoPr/OKWjquZR1SWKXcvxdH+e1xrx89b3YbmzLMFCLfnaG1HFIgWzJOEWZ7MvpK++odZufgYR50Rw==",
      "license": "MIT",
      "engines": {
        "node": ">=10.0.0"
      },
      "peerDependencies": {
        "bufferutil": "^4.0.1",
        "utf-8-validate": ">=5.0.2"
      },
      "peerDependenciesMeta": {
        "bufferutil": {
          "optional": true
        },
        "utf-8-validate": {
          "optional": true
        }
      }
    },
    "packages/client": {
      "name": "@bitnik/client",
      "version": "0.1.0",
      "license": "UNLICENSED"
    },
    "packages/engine": {
      "name": "@bitnik/engine",
      "version": "0.1.0",
      "license": "UNLICENSED",
      "engines": {
        "node": ">=18"
      }
    },
    "packages/server": {
      "name": "@bitnik/server",
      "version": "0.1.0",
      "license": "UNLICENSED",
      "dependencies": {
        "@bitnik/client": "^0.1.0",
        "@bitnik/engine": "^0.1.0",
        "ws": "^8.18.0"
      }
    }
  }
}
